{
  "name": "cfs-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Anonymous confession submission platform with admin moderation",
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run start:dev --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "lint:frontend": "npm run lint --prefix frontend",
    "lint:backend": "npm run lint --prefix backend",
    "test:backend": "npm run test --prefix backend",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate --prefix backend",
    "db:generate": "npm run prisma:generate --prefix backend"
  },
  "workspaces": [
    "frontend",
    "backend"
  ]
}
