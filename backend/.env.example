# Local PostgreSQL (docker-compose)
DATABASE_URL=postgresql://cfs:cfs@localhost:5432/cfs?schema=public

PORT=3001

# Auth (Phase 2+)
JWT_SECRET=change-me-use-long-random-string-min-32-chars

# CORS — frontend origin
FRONTEND_URL=http://localhost:3000

# Cloudflare R2 (Phase 4+)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Optional bootstrap admin (Phase 2+)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
